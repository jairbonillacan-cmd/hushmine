// Estación de pozo: ensanche con suelo de roca, raíles (id 13), una vagoneta
// (id 16) y la baliza de señales (id 14) en el muro sur. El pozo la atraviesa.
Piece(
    id: "shaft_station",
    family: "ancient_mine",
    is_cap: false,
    size: [11, 5, 7],
    fills: [
        // Suelo de roca del nivel
        [0, 0, 0, 11, 1, 7, 2],
        // Raíles a ambos lados de la boca del pozo
        [2, 0, 3, 4, 1, 4, 13],
        [7, 0, 3, 9, 1, 4, 13],
        // Cámara de la estación
        [0, 1, 0, 11, 4, 7, 0],
        // Canal del pozo: corta suelo y techo de parte a parte
        [4, 0, 2, 7, 5, 5, 0],
        // Baliza de señales en el muro sur
        [8, 1, 5, 9, 3, 6, 14],
        // Vagoneta descarrilada junto a los raíles
        [1, 1, 5, 2, 2, 6, 16],
    ],
    connectors: [
        (pos: [5, 5, 3], dir: "up", kind: "shaft"),
        (pos: [5, 0, 3], dir: "down", kind: "shaft"),
        (pos: [11, 1, 3], dir: "east", kind: "track"),
        (pos: [0, 1, 3], dir: "west", kind: "track"),
        (pos: [5, 1, 0], dir: "north", kind: "gallery"),
        (pos: [5, 1, 7], dir: "south", kind: "gallery"),
    ],
)
