# Crónica posterior al turno (Español de Latinoamérica — es-419)

# Cabecera y resultado del turno (7)
chronicle-header = Crónica posterior al Turno
chronicle-subheader = Monte Anima · Semilla #{ $seed } · Duración { $duration }
chronicle-victory-quota = { $team } ganó el Turno al alcanzar la cuota de ${ $cash }.
chronicle-victory-clock = { $team } ganó el Turno con ${ $cash } en el banco cuando despertó el Durmiente.
chronicle-draw = El Turno terminó en empate con ${ $cash } en ambos bancos.
chronicle-share-button = Compartir imagen de la Crónica
chronicle-save-replay = Guardar repetición del Turno

# Eventos destacados del turno (13)
chronicle-event-stir = Min { $time } · El Sismógrafo cruzó el 25% (Revuelo) mientras resonaban los Silbadores.
chronicle-event-breathe = Min { $time } · El Sismógrafo cruzó el 50% (Respira) y abrió una Veta Madre.
chronicle-event-restless = Min { $time } · El Sismógrafo cruzó el 75% (Inquietud) y se rompieron bolsas de lava.
chronicle-event-wake = Min { $time } · { $team } llevó el Sismógrafo al 100% (Despertar), dejando expuesto el Corazón.
chronicle-event-wake-passive = Min { $time } · El Sismógrafo alcanzó el 100% (Despertar) y dejó expuesto el Corazón.
chronicle-event-buckets-stopped = Min { $time } · Toda Línea de cangilones se detuvo a 30 segundos del colapso.
chronicle-event-awakening-ended = Min { $time } · Terminó el Despertar y el Durmiente selló el pozo.
chronicle-event-noise-blasts = { $count -> [one] Min { $time } · { $team } sacudió la montaña con { $count } explosión de demolición (+{ $noise } pts). *[other] Min { $time } · { $team } sacudió la montaña con { $count } explosiones de demolición (+{ $noise } pts). }
chronicle-event-offering = { $count -> [one] Min { $time } · { $team } pagó { $count } Ofrenda (${ $gold }) para bajar el Sismógrafo en { $reduction } pts. *[other] Min { $time } · { $team } pagó { $count } Ofrendas (${ $gold }) para bajar el Sismógrafo en { $reduction } pts. }
chronicle-event-tally = Min { $time } · { $team } devolvió la Ficha de latón #{ $number } al altar (-{ $reduction } pts).
chronicle-event-fame = Min { $time } · { $team } superó el 60% de la meta (${ $cash }) y quedó marcado por la Fama.
chronicle-event-heist = Min { $time } · { $team } cortó una Línea de cangilones rival y robó ${ $cash } en oro.
chronicle-event-heart-claimed = Min { $time } · { $player } ({ $team }) extrajo ${ $cash } desde el Corazón.

# Títulos y menciones de jugadores (8)
chronicle-title-awakener = Despertador
chronicle-title-awakener-desc = { $player } generó más ruido en el Sismógrafo (+{ $noise } pts).
chronicle-title-slumber-guardian = Guardián del sueño
chronicle-title-slumber-guardian-desc = { $count -> [one] { $player } calmó al Durmiente con { $count } Ofrenda (${ $gold }). *[other] { $player } calmó al Durmiente con { $count } Ofrendas (${ $gold }). }
chronicle-title-mole = Topo
chronicle-title-mole-desc = { $blocks -> [one] { $player } excavó { $blocks } metro de roca sólida. *[other] { $player } excavó { $blocks } metros de roca sólida. }
chronicle-title-bucket-thief = Ladrón de cangilones
chronicle-title-bucket-thief-desc = { $count -> [one] { $player } saqueó { $count } cangilón rival en la Línea de cangilones (${ $cash }). *[other] { $player } saqueó { $count } cangilones rivales en la Línea de cangilones (${ $cash }). }
