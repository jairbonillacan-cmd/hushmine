# Crónica posterior al turno (Inglés — idioma fuente canónico)

# Cabecera y resultado del turno (7)
chronicle-header = Post-Shift Chronicle
chronicle-subheader = Mount Anima · Seed #{ $seed } · Duration { $duration }
chronicle-victory-quota = { $team } won the Shift by reaching the ${ $cash } quota.
chronicle-victory-clock = { $team } won the Shift with ${ $cash } in the bank when the Sleeper woke.
chronicle-draw = The Shift ended in a tie with ${ $cash } in both banks.
chronicle-share-button = Share Chronicle Image
chronicle-save-replay = Save Shift Replay

# Eventos destacados del turno (13)
chronicle-event-stir = Min { $time } · The Seismograph crossed 25% (Stir) as the Whistlers echoed.
chronicle-event-breathe = Min { $time } · The Seismograph crossed 50% (Breathe), cracking open a Mother Lode.
chronicle-event-restless = Min { $time } · The Seismograph crossed 75% (Restless) and lava pockets ruptured.
chronicle-event-wake = Min { $time } · { $team } pushed the Seismograph to 100% (Wake), exposing the Heart.
chronicle-event-wake-passive = Min { $time } · The Seismograph reached 100% (Wake) and exposed the Heart.
chronicle-event-buckets-stopped = Min { $time } · All Bucket lines stopped with 30 seconds left before collapse.
chronicle-event-awakening-ended = Min { $time } · The Awakening ended and the Sleeper sealed the shaft.
chronicle-event-noise-blasts = { $count -> [one] Min { $time } · { $team } shook the mountain with { $count } demolition blast (+{ $noise } pts). *[other] Min { $time } · { $team } shook the mountain with { $count } demolition blasts (+{ $noise } pts). }
chronicle-event-offering = { $count -> [one] Min { $time } · { $team } paid { $count } Offering (${ $gold }) to lower the Seismograph by { $reduction } pts. *[other] Min { $time } · { $team } paid { $count } Offerings (${ $gold }) to lower the Seismograph by { $reduction } pts. }
chronicle-event-tally = Min { $time } · { $team } returned Brass tally #{ $number } to the altar (-{ $reduction } pts).
chronicle-event-fame = Min { $time } · { $team } passed 60% of the goal (${ $cash }) and was marked by Fame.
chronicle-event-heist = Min { $time } · { $team } severed a rival Bucket line and stole ${ $cash } in gold.
chronicle-event-heart-claimed = Min { $time } · { $player } ({ $team }) extracted ${ $cash } from the Heart.

# Títulos y menciones de jugadores (8)
chronicle-title-awakener = Awakener
chronicle-title-awakener-desc = { $player } generated the most noise on the Seismograph (+{ $noise } pts).
chronicle-title-slumber-guardian = Slumber Guardian
chronicle-title-slumber-guardian-desc = { $count -> [one] { $player } calmed the Sleeper with { $count } Offering (${ $gold }). *[other] { $player } calmed the Sleeper with { $count } Offerings (${ $gold }). }
chronicle-title-mole = Mole
chronicle-title-mole-desc = { $blocks -> [one] { $player } excavated { $blocks } meter of solid rock. *[other] { $player } excavated { $blocks } meters of solid rock. }
chronicle-title-bucket-thief = Bucket Thief
chronicle-title-bucket-thief-desc = { $count -> [one] { $player } raided { $count } rival bucket on the Bucket line (${ $cash }). *[other] { $player } raided { $count } rival buckets on the Bucket line (${ $cash }). }
