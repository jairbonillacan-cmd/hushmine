// Relieve de HUSHMINE: parámetros de ruido 2D por columna y curvas de altura.
// Fuente: docs/mundo/02-generacion.md §3 (parámetros 2D continuos, en Q16).
//
// Todo entero: la salida del ruido de gradiente vive en [-65_536, 65_536]
// (Q16 con signo) y aquí no existe ningún número con punto decimal.

Relief(
    // Seis parámetros 2D por columna, en el orden del doc §3. period_shift es
    // el desplazamiento de la retícula del ruido de gradiente entero: celda
    // de lado 2^K bloques (celda = x >> K). octaves son las octavas de fBm.
    noise_params: [
        // Continentalidad: 4096 bloques ≈ 4 km (rango del doc: 2-8 km).
        (name: "continentality", period_shift: 12, octaves: 4),
        // Erosión: 2048 ≈ 2 km (rango del doc: 1-4 km).
        (name: "erosion", period_shift: 11, octaves: 4),
        // Picos y valles: 512 m, ruido en cresta (rango del doc: 300-1000 m).
        (name: "peaks_valleys", period_shift: 9, octaves: 5),
        // Temperatura: 8192 ≈ 8 km (rango del doc: 4-12 km).
        (name: "temperature", period_shift: 13, octaves: 3),
        // Humedad: 4096 ≈ 4 km (rango del doc: 2-6 km).
        (name: "humidity", period_shift: 12, octaves: 3),
        // Rareza (weirdness): 1024 ≈ 1 km (rango del doc: 1-3 km).
        (name: "weirdness", period_shift: 10, octaves: 4),
    ],
    // Altura base por columna. input_q16 NO es un parámetro suelto sino el
    // índice combinado normalizado: una mezcla de continentalidad, erosión y
    // picos y valles reescalada al rango Q16 [-65_536, 65_536]. Por eso la
    // curva no es monótona: mares profundos en el extremo negativo, un valle
    // de llanuras hacia el centro del índice y montañas que crecen hacia el
    // extremo positivo (el macizo del Durmiente se suma aparte, hasta ~900).
    base_height_curve: [
        (input_q16: -65_536, output: -64),  // Mares interiores profundos, continentalidad mínima
        (input_q16: -49_152, output: -16),  // Plataforma costera somera y playas de grava
        (input_q16: -32_768, output: 72),   // Llanuras litorales
        (input_q16: -16_384, output: 96),   // Colinas suaves
        (input_q16: 0, output: 64),         // Llanuras centrales: el valle del índice
        (input_q16: 16_384, output: 120),   // Llanuras altas
        (input_q16: 32_768, output: 260),   // Altiplanos y mesas
        (input_q16: 49_152, output: 560),   // Montañas (con erosión baja y picos altos)
        (input_q16: 65_536, output: 950),   // Extremo: cumbres; el macizo se suma aparte
    ],
    // Pendiente en milésimas de densidad por bloque; 950 = 0,95 bloques de
    // densidad por bloque de desnivel. Mismo índice combinado que la curva de
    // altura: valores bajos con erosión alta (colinas suaves) y valores altos
    // con erosión mínima (acantilados casi verticales).
    slope_factor_curve: [
        (input_q16: -65_536, output: 120),  // Fondos marinos casi planos
        (input_q16: -49_152, output: 160),  // Plataforma costera
        (input_q16: -32_768, output: 220),  // Llanuras: erosión alta, colinas suaves
        (input_q16: -16_384, output: 380),  // Colinas rodadas
        (input_q16: 0, output: 450),        // Transición hacia mesas
        (input_q16: 16_384, output: 580),   // Bordes de altiplano
        (input_q16: 32_768, output: 750),   // Laderas de montaña
        (input_q16: 49_152, output: 880),   // Alta montaña
        (input_q16: 65_536, output: 950),   // Acantilados casi verticales, erosión mínima
    ],
    // Ríos (docs/mundo/02-generacion.md §3): ruido en cresta de baja frecuencia
    // que hunde la altura hasta el nivel del agua. Aparecen donde la cresta
    // supera este umbral, ≈ 0,9 del rango Q16 del ruido en cresta
    // (58_982 / 65_536).
    river_threshold_q16: 58_982,
)
