// Comercio del modo Historia (supervivencia): oficios NPC, precios y tramos de reputación.
// Cifras provisionales de docs/supervivencia/03-pueblos-y-comercio.md (§3 y §4); precios en granos
// de oro ensayado, todos enteros. Convención desde el punto de vista del JUGADOR:
//   buy_price_gold  = lo que el jugador PAGA al comprar al NPC.
//   sell_price_gold = lo que el jugador RECIBE al vender al NPC.
// Invariante de economía: en toda oferta buy_price_gold > sell_price_gold >= 1 (nadie compra más
// caro de lo que vende). El ancla son los base_value_gold de objetos.ron: comprar ronda el
// 130-200 % del valor base (el mecánico y el polvorinero de la Consolidada pagan por encima)
// y vender el 50-100 %. reputation_tiers da el descuento porcentual que
// se aplica al precio de compra según la reputación del pueblo con la facción del NPC.

Traders(
    traders: [
        // Lampistería de los Llegados: compra cristales y polvos luminosos, vende lámparas,
        // combustible y piadores en jaula. La lámpara de luz fría no prende el gas.
        (
            id: "lamplighter",
            name: "Lamplighter",
            faction: "arrivals",
            offers: [
                ( item_id: "vault_glass", buy_price_gold: 30, sell_price_gold: 12 ),
                ( item_id: "mica_dust", buy_price_gold: 9, sell_price_gold: 3 ),
                ( item_id: "lumen_crystal", buy_price_gold: 15, sell_price_gold: 6 ),
                ( item_id: "candle", buy_price_gold: 3, sell_price_gold: 1 ),
                ( item_id: "oil_lamp", buy_price_gold: 5, sell_price_gold: 2 ),
                ( item_id: "safety_lamp", buy_price_gold: 36, sell_price_gold: 14 ),
                ( item_id: "cold_light_lamp", buy_price_gold: 40, sell_price_gold: 16 ),
                ( item_id: "lumen_lamp", buy_price_gold: 48, sell_price_gold: 19 ),
                ( item_id: "lamp_oil", buy_price_gold: 5, sell_price_gold: 2 ),
                ( item_id: "peeper_cage", buy_price_gold: 8, sell_price_gold: 3 ),
            ],
            reputation_tiers: [
                ( min_reputation: -100, discount_pct: 0 ),
                ( min_reputation: 25, discount_pct: 10 ),
                ( min_reputation: 50, discount_pct: 20 ),
                ( min_reputation: 75, discount_pct: 30 ),
            ],
        ),
        // Herrero de los Llegados: compra menas, lingotes y carbón; vende herramientas y
        // herramientas-arma. Reparación y mejora se ofrecen en la fragua, no en la tabla.
        (
            id: "blacksmith",
            name: "Blacksmith",
            faction: "arrivals",
            offers: [
                ( item_id: "copper_ore", buy_price_gold: 3, sell_price_gold: 1 ),
                ( item_id: "tin_ore", buy_price_gold: 3, sell_price_gold: 1 ),
                ( item_id: "iron_ore", buy_price_gold: 3, sell_price_gold: 1 ),
                ( item_id: "coal", buy_price_gold: 3, sell_price_gold: 1 ),
                ( item_id: "copper_ingot", buy_price_gold: 6, sell_price_gold: 2 ),
                ( item_id: "iron_ingot", buy_price_gold: 9, sell_price_gold: 3 ),
                ( item_id: "bronze_ingot", buy_price_gold: 9, sell_price_gold: 3 ),
                ( item_id: "stone_pick", buy_price_gold: 9, sell_price_gold: 3 ),
                ( item_id: "shovel", buy_price_gold: 8, sell_price_gold: 3 ),
                ( item_id: "mace", buy_price_gold: 18, sell_price_gold: 6 ),
                ( item_id: "pry_bar", buy_price_gold: 24, sell_price_gold: 9 ),
                ( item_id: "shears", buy_price_gold: 24, sell_price_gold: 9 ),
                ( item_id: "iron_pick", buy_price_gold: 24, sell_price_gold: 9 ),
                ( item_id: "bronze_pick", buy_price_gold: 27, sell_price_gold: 10 ),
            ],
            reputation_tiers: [
                ( min_reputation: -100, discount_pct: 0 ),
                ( min_reputation: 25, discount_pct: 10 ),
                ( min_reputation: 50, discount_pct: 20 ),
                ( min_reputation: 75, discount_pct: 30 ),
            ],
        ),
        // Ensayador de los Llegados: compra todo el mineral y lo convierte en granos; distingue
        // el oro soñado. Dilema del §4: paga el oro soñado a 8 granos, ~70 % del oro normal
        // (12 de base); ofrendarlo calma al Durmiente de la zona. Su buy_price_gold del oro
        // soñado es solo la tasación de referencia: no guarda existencias para revender, así
        // que hush-sim no debe ponerlo a la venta en su tienda.
        (
            id: "assayer",
            name: "Assayer",
            faction: "arrivals",
            offers: [
                ( item_id: "copper_ore", buy_price_gold: 3, sell_price_gold: 1 ),
                ( item_id: "tin_ore", buy_price_gold: 3, sell_price_gold: 1 ),
